<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SignaCore.ReferenceBff</RootNamespace>
    <!-- A reference sample, not a product binary: never packed, never shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BFF's own storage: the role-binding context plus the SQLite migration history that
         the runtime never applies automatically (operators migrate before starting). -->
    <ProjectReference Include="..\SignaCore.ReferenceBff.Database\SignaCore.ReferenceBff.Database.csproj" />
    <ProjectReference Include="..\SignaCore.ReferenceBff.Database.Migrations.Sqlite\SignaCore.ReferenceBff.Database.Migrations.Sqlite.csproj" />
  </ItemGroup>

</Project>
