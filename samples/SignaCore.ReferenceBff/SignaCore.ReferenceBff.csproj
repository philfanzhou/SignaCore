<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SignaCore.ReferenceBff</RootNamespace>
    <!-- A reference sample, not a product binary: never packed, never shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SignaCore.ReferenceBff.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ServiceMantle.Web" />
    <PackageReference Include="ServiceMantle.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosted-login client package owns the OIDC handshake, the server-side session, and the
         prepared-logout surface; the sample references it as a project so both always move
         together inside this repository. -->
    <ProjectReference Include="..\..\src\SignaCore.Client.AspNetCore\SignaCore.Client.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BFF's own storage: the role-binding context plus the SQLite migration history that
         the runtime never applies automatically (operators migrate before starting). -->
    <ProjectReference Include="..\SignaCore.ReferenceBff.Database\SignaCore.ReferenceBff.Database.csproj" />
    <ProjectReference Include="..\SignaCore.ReferenceBff.Database.Migrations.Sqlite\SignaCore.ReferenceBff.Database.Migrations.Sqlite.csproj" />
  </ItemGroup>

</Project>
