<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are executables hosted by Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pins the assembly's parallelism contract so local full runs and CI make the same
         scheduling assumptions (issue #293): collections run in parallel, assemblies never. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- Supplies the hang dump option, the Microsoft.Testing.Platform replacement for VSTest blame-hang. -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SignaCore.Database\SignaCore.Database.csproj" />
    <ProjectReference Include="..\..\src\SignaCore.Domain\SignaCore.Domain.csproj" />
    <ProjectReference Include="..\..\src\SignaCore.Host\SignaCore.Host.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <ExcludeAssets>buildTransitive</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
