<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are executables hosted by Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      xUnit1051 asks every cancellable call to flow TestContext.Current.CancellationToken. The
      analyzer is new in v3 and fires across the existing suite; adopting it is tracked as
      follow-up work so this migration stays reviewable.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SignaCore.Database\SignaCore.Database.csproj" />
    <ProjectReference Include="..\..\src\SignaCore.Domain\SignaCore.Domain.csproj" />
    <ProjectReference Include="..\..\src\SignaCore.Host\SignaCore.Host.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <ExcludeAssets>buildTransitive</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
