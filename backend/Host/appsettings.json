{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [
            {
              "key": "service",
              "value": "QuantumZhou.Identity"
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Endpoints": {
    "Http": 5002,
    "AdminApi": 5010
  },
  "AdminWeb": {
    "AdminUsernames": [],
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "Provider": "PostgreSQL",
    "Name": "quantumzhou_identity",
    "AutoMigrate": true
  },
  "PostgreSql": {
    "Host": "localhost",
    "Port": 5432,
    "Username": "phil"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=quantumzhou_identity;Username=phil",
    "PostgreSQL": "Host=localhost;Port=5432;Database=quantumzhou_identity;Username=phil"
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "Jwt": {
    "Issuer": "QuantumZhou.Identity",
    "Audience": "QuantumZhou.microservices",
    "TokenExpirationHours": 2
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "FeatureFlags": {
    "EnableNewLogin": true,
    "EnablePeriodicCheckIn": true
  },
  "Sms": {
    "OtpTtlSeconds": 300,
    "MaxAttempts": 5,
    "LockoutSeconds": 600,
    "BypassCode": ""
  },
  "WeChat": {
    "AppId": "",
    "AppSecret": "",
    "ApiBaseUrl": "https://api.weixin.qq.com"
  },
  "Callback": {
    "AllowedDomains": []
  },
  "TeacherPortal": {
    "AppId": "",
    "AppSecret": "",
    "CallbackUrl": "http://localhost:5004/api/auth/callback"
  },
  "AdminBootstrap": {
    "Username": "admin",
    "Password": ""
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "QuantumZhou.Identity",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul",
    "Discovery": {
      "Enabled": true,
      "ServiceName": "QuantumZhou.Identity",
      "HealthCheckPath": "/health",
      "HealthCheckInterval": "10s",
      "HealthCheckTimeout": "10s",
      "HealthCheckCriticalTimeout": "30m",
      "Register": true,
      "Deregister": true,
      "FailFast": false
    }
  }
}
