{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [
            {
              "key": "service",
              "value": "QuantumZhou.Identity"
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Endpoints": {
    "Grpc": 5001,
    "Http": 5002,
    "AdminApi": 5010
  },
  "AdminWeb": {
    "AdminUsernames": [],
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "Provider": "PostgreSQL",
    "AutoMigrate": true
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=quantumzhou_identity;Username=phil",
    "PostgreSQL": "Host=localhost;Port=5432;Database=quantumzhou_identity;Username=phil"
  },
  "Jwt": {
    "Issuer": "QuantumZhou.Identity",
    "Audience": "QuantumZhou.microservices",
    "TokenExpirationHours": 2
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "Sms": {
    "OtpTtlSeconds": 300,
    "MaxAttempts": 5,
    "LockoutSeconds": 600,
    "BypassCode": ""
  },
  "WeChat": {
    "AppId": "",
    "AppSecret": "",
    "ApiBaseUrl": "https://api.weixin.qq.com"
  },
  "RateLimiting": {
    "PermitLimitPerClient": 20,
    "WindowSeconds": 60,
    "CleanupIntervalSeconds": 300
  },
  "Grpc": {
    "MaxReceiveMessageSize": 4194304,
    "MaxSendMessageSize": 4194304
  },
  "Callback": {
    "AllowedDomains": []
  },
  "TeacherPortal": {
    "AppId": "",
    "AppSecret": "",
    "CallbackUrl": "http://localhost:5004/api/auth/callback"
  },
  "AdminBootstrap": {
    "Username": "admin",
    "Password": ""
  }
}
